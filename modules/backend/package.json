{
  "name": "backend",
  "private": true,
  "engines": {
    "node": ">= 24"
  },
  "config": {
    "BUILD_DIR_NAME": "dist"
  },
  "scripts": {
    "build": "yarn && yarn run compile && ./build.sh",
    "compile": "tsc -p ./",
    "test": "mocha",
    "lint": "eslint src",
    "coverage": "nyc yarn test",
    "publish-artifact": "yarn run build && yarn run coverage && cd ops && yarn && node upload-artifact",
    "deploy": "cd ops && yarn && kumo deploy-module --verbose",
    "destroy": "cd ops && kumo destroy-module --verbose",
    "test_module": "yarn && yarn run compile && yarn run lint && yarn test && yarn --cwd ops && yarn --cwd ops test"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1057.0",
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/lib-dynamodb": "^3.1056.0",
    "aws-xray-sdk": "^3.12.0",
    "lodash.get": "~4.4.2",
    "lodash.keyby": "~4.6.0",
    "lodash.map": "~4.6.0",
    "lodash.omit": "~4.18.0",
    "route-parser": "0.0.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.keyby": "^4.6.9",
    "@types/lodash.map": "^4.6.13",
    "@types/lodash.omit": "^4.5.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "@types/route-parser": "^0.1.7",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.4.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "testdouble": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
