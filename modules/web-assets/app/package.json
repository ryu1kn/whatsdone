{
  "name": "web-assets-app",
  "private": true,
  "types": "src/main.d.ts",
  "engines": {
    "node": ">=24.11.0"
  },
  "config": {
    "buildDir": "./dist"
  },
  "scripts": {
    "prestart:dev": "yarn run build:dev && cp ../app-config/dev.json $npm_package_config_buildDir/appConfig.json",
    "start:dev": "webpack server --mode development",
    "start:api": "node api-server.js",
    "prebuild:dev": "yarn run clean",
    "build:dev": "NODE_ENV=dev webpack",
    "prebuild:production": "yarn run clean",
    "build:production": "NODE_ENV=production webpack",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf $npm_package_config_buildDir"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.22",
    "bootstrap": "^5.3.8",
    "core-js": "^3.51.0",
    "jquery": "^4.0.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "redux": "^5.0.1",
    "showdown": "^2.1.0",
    "util": "^0.12.5",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@popperjs/core": "^2.11.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/showdown": "^2.0.6",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "cors": "^2.8.6",
    "css-loader": "^7.1.5",
    "express": "^5.3.0",
    "favicons": "^7.3.1",
    "favicons-webpack-plugin": "^6.0.1",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "mini-css-extract-plugin": "^2.10.2",
    "regenerator-runtime": "^0.14.1",
    "style-loader": "^4.0.0",
    "testdouble": "^4.0.0",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "jest": {
    "cacheDirectory": ".cache/jest",
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/.cache/"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/file.ts",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/style.ts"
    }
  }
}
