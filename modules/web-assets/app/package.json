{
  "name": "web-assets-app",
  "private": true,
  "types": "src/main.d.ts",
  "engines": {
    "node": ">= 24"
  },
  "config": {
    "buildDir": "./dist"
  },
  "scripts": {
    "prestart:dev": "yarn run build:dev && cp ../app-config/dev.json $npm_package_config_buildDir/appConfig.json",
    "start:dev": "webpack server --mode development",
    "start:api": "node api-server.js",
    "prebuild:dev": "yarn run clean",
    "build:dev": "NODE_ENV=dev webpack",
    "prebuild:production": "yarn run clean",
    "build:production": "NODE_ENV=production webpack",
    "postbuild:dev": "yarn run remove-dup-static",
    "postbuild:production": "yarn run remove-dup-static",
    "remove-dup-static": "mv $npm_package_config_buildDir/static/static/* $npm_package_config_buildDir/static && rmdir $npm_package_config_buildDir/static/static # HACK",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf $npm_package_config_buildDir"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^1.31.0",
    "bootstrap": "^3.3.7",
    "core-js": "^3.47.1",
    "jquery": "^3.6.0",
    "jwt-decode": "^3.1.2",
    "lodash": "~4.18.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.4",
    "react-router-dom": "^5.2.0",
    "redux": "^4.1.0",
    "showdown": "^1.9.1",
    "util": "^0.12.4",
    "whatwg-fetch": "~3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.14.6",
    "@babel/preset-env": "^7.14.5",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.14.5",
    "@babel/register": "^7.14.5",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.0.0",
    "@types/jest": "^26.0.23",
    "@types/lodash": "^4.14.170",
    "@types/react": "^17.0.11",
    "@types/react-dom": "^17.0.8",
    "@types/react-router-dom": "^5.1.7",
    "@types/showdown": "^1.9.3",
    "babel-jest": "^27.0.2",
    "babel-loader": "^8.2.2",
    "cors": "^2.8.6",
    "css-loader": "^7.1.2",
    "express": "^4.20.0",
    "favicons": "^7.3.0",
    "favicons-webpack-plugin": "^6.0.1",
    "html-webpack-plugin": "^5.3.1",
    "jest": "^27.0.4",
    "json-loader": "^0.5.7",
    "less": "^4.1.1",
    "less-loader": "^10.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "regenerator-runtime": "^0.13.7",
    "style-loader": "^4.0.0",
    "testdouble": "^3.16.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.4"
  },
  "jest": {
    "cacheDirectory": ".cache/jest",
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/.cache/"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/file.ts",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/style.ts"
    }
  }
}
